<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="local.quiethome" android:versionCode="7" android:versionName="0.2-dev">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <queries>
        <package android:name="com.tcl.tv" />
        <package android:name="com.tcl.airplay2" />
        <package android:name="com.android.tv.settings" />
    </queries>
    <application android:label="Quiet Home" android:theme="@android:style/Theme.Material.NoActionBar" android:allowBackup="false" android:supportsRtl="true">
        <uses-library android:name="com.tcl.tv.display" android:required="false" />
        <activity android:name=".HomeActivity" android:exported="true" android:screenOrientation="landscape" android:launchMode="singleTask" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
